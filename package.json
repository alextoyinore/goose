{
  "name": "gold-signal-desk",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "concurrently -k \"vite --host 127.0.0.1 --port 5191 --strictPort\" \"wait-on http://127.0.0.1:5191 && electron .\"",
    "build": "tsc -b && vite build",
    "pack:win": "npm run build && electron-builder --win nsis --x64",
    "preview": "vite preview --host 127.0.0.1",
    "electron": "electron ."
  },
  "build": {
    "appId": "com.aurum.gold-signal-desk",
    "productName": "Aurum Gold Signal Desk",
    "directories": {
      "output": "release"
    },
    "asar": true,
    "files": [
      "web-dist/**/*",
      "electron/**/*",
      "assets/aurum.ico",
      "package.json",
      "NOTICE"
    ],
    "extraResources": [
      {
        "from": "engine",
        "to": "engine",
        "filter": [
          "main.py",
          "PROTOCOL.md",
          "BUNDLED_RUNTIME.md",
          "requirements-mt5.txt",
          "vendor/**/*",
          "python-runtime/**/*"
        ]
      }
    ],
    "win": {
      "icon": "assets/aurum.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  },
  "dependencies": {
    "lightweight-charts": "^5.0.8",
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.0",
    "electron": "^33.2.1",
    "electron-builder": "^26.0.12",
    "typescript": "~5.6.2",
    "vite": "^6.0.1",
    "wait-on": "^8.0.1"
  }
}
